{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sb/rest/v1/(.*)",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/sb/auth/v1/(.*)",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/sb/storage/v1/object/public/(.*)",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sb/rest/v1/:path*", "destination": "https://sgfoesnpodvwyzlxfhtq.supabase.co/rest/v1/:path*" },
    { "source": "/sb/auth/v1/:path*", "destination": "https://sgfoesnpodvwyzlxfhtq.supabase.co/auth/v1/:path*" },
    { "source": "/sb/storage/v1/:path*", "destination": "https://sgfoesnpodvwyzlxfhtq.supabase.co/storage/v1/:path*" }
  ]
}
