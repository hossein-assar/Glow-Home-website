# Copy to payment-server/.env and fill in on the server. NEVER commit .env.
# All values below are fake placeholders.

# On the Iranian VPS use the shop's proxy, https://glow-home.ir/sb — direct
# calls to *.supabase.co stall from Iran (README "Supabase route").
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase -> Project Settings -> API keys -> secret / service_role key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# sandbox: any UUID works. production: your real 36-char ZarinPal merchant id.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# sandbox | production (defaults to sandbox if unset)
ZARINPAL_MODE=sandbox

# Where customers are sent back after paying (the storefront).
PUBLIC_SITE_URL=https://glow-home.ir
# Public HTTPS address of THIS server.
PUBLIC_API_URL=https://pay.example.ir

# Optional: the callback_url sent to ZarinPal. Unset = PUBLIC_API_URL/api/verify
# (fine in sandbox). Production ZarinPal only accepts a callback on the shop's
# registered domain, so there use the shop's forwarding function, which
# redirects to PUBLIC_API_URL/api/verify:
CALLBACK_URL=https://glow-home.ir/api/pay-callback

PORT=3000
